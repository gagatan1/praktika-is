<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Процесс API-тестирования веб-приложения" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_QA" name="Тестировщик">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Def</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="Система API-тестирования">
        <bpmn:flowNodeRef>T_Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_More</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Bug</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Bug</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API" name="Тестируемое веб-приложение (API)">
        <bpmn:flowNodeRef>T_Process</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Нужно проверить API">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Import" name="Импортировать спецификацию API (OpenAPI/Swagger)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Create" name="Создать тест-кейсы (запросы и проверки)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Run" name="Выбрать окружение и запустить прогон">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Load" name="Загрузить тест-кейсы и переменные окружения">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Send" name="Отправить HTTP-запрос к API">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Process" name="Обработать запрос и вернуть ответ">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Validate" name="Проверить ответ (код, схема, данные, время)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Pass" name="Проверки пройдены?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Ok" name="Отметить тест пройденным">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Fail" name="Отметить тест проваленным и сохранить детали ошибки">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Merge">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_More" name="Есть ещё тест-кейсы?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Report" name="Сформировать отчёт о прогоне">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_Analyze" name="Проанализировать отчёт">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Def" name="Обнаружены дефекты?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Bug" name="Создать дефекты в баг-трекере">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_OK" name="API успешно протестировано">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Bug" name="Дефекты переданы разработчикам">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Import" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Import" targetRef="T_Create" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Create" targetRef="T_Run" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Run" targetRef="T_Load" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Load" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Send" targetRef="T_Process" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Process" targetRef="T_Validate" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_Validate" targetRef="G_Pass" />
    <bpmn:sequenceFlow id="F9" name="Да" sourceRef="G_Pass" targetRef="T_Ok" />
    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="G_Pass" targetRef="T_Fail" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Ok" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Fail" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="F13" sourceRef="G_Merge" targetRef="G_More" />
    <bpmn:sequenceFlow id="F14" name="Да" sourceRef="G_More" targetRef="T_Send" />
    <bpmn:sequenceFlow id="F15" name="Нет" sourceRef="G_More" targetRef="T_Report" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Report" targetRef="T_Analyze" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Analyze" targetRef="G_Def" />
    <bpmn:sequenceFlow id="F18" name="Нет" sourceRef="G_Def" targetRef="End_OK" />
    <bpmn:sequenceFlow id="F19" name="Да" sourceRef="G_Def" targetRef="T_Bug" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_Bug" targetRef="End_Bug" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1660" height="660" /></bpmndi:BPMNShape>
