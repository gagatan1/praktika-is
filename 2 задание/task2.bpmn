<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Регистрация пользователя на сайте" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Activate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Начало регистрации">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Input" name="Ввести данные (имя, email, пароль)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Validate" name="Проверить корректность данных">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Данные корректны?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendEmail" name="Отправить письмо для подтверждения">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Error" name="Показать сообщение об ошибке">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm" name="Подтвердить регистрацию (перейти по ссылке)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Activate" name="Активировать учётную запись">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Регистрация завершена успешно">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_1" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Input" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="F4" name="Да" sourceRef="Gateway_Valid" targetRef="Task_SendEmail" />
    <bpmn:sequenceFlow id="F5" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_Error" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Error" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_SendEmail" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Confirm" targetRef="Task_Activate" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Activate" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1200" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1170" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="1170" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="222" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="207" y="215" width="66" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Input_di" bpmnElement="Task_Input">
        <dc:Bounds x="310" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="460" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="625" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="590" y="318" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendEmail_di" bpmnElement="Task_SendEmail">
        <dc:Bounds x="740" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Error_di" bpmnElement="Task_Error">
        <dc:Bounds x="600" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="890" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Activate_di" bpmnElement="Task_Activate">
        <dc:Bounds x="1040" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1232" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1205" y="120" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="258" y="190" /><di:waypoint x="310" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="410" y="190" /><di:waypoint x="510" y="190" /><di:waypoint x="510" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="560" y="380" /><di:waypoint x="625" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="675" y="380" /><di:waypoint x="740" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="362" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="650" y="405" /><di:waypoint x="650" y="480" />
        <bpmndi:BPMNLabel><dc:Bounds x="658" y="435" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="600" y="520" /><di:waypoint x="360" y="520" /><di:waypoint x="360" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="840" y="380" /><di:waypoint x="940" y="380" /><di:waypoint x="940" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="990" y="190" /><di:waypoint x="1090" y="190" /><di:waypoint x="1090" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1140" y="380" /><di:waypoint x="1250" y="380" /><di:waypoint x="1250" y="208" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
